{
	"name": "@conference/db",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./schema": {
			"types": "./dist/schema/index.d.ts",
			"import": "./dist/schema/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js"
		}
	},
	"scripts": {
		"build": "tsup src/index.ts src/client.ts src/schema/index.ts --format esm --platform node --target node22 --out-dir dist --dts --sourcemap --clean",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"generate": "drizzle-kit generate --config=drizzle.config.cjs",
		"migrate": "tsx src/migrate.ts",
		"push": "drizzle-kit push --config=drizzle.config.cjs",
		"studio": "drizzle-kit studio --config=drizzle.config.cjs",
		"seed": "tsx src/seed/demo.ts",
		"lint": "eslint ."
	},
	"dependencies": {
		"drizzle-orm": "^0.45.2",
		"pg": "^8.13.1"
	},
	"devDependencies": {
		"@faker-js/faker": "^9.3.0",
		"@types/bcryptjs": "^2.4.6",
		"@types/pg": "^8.11.10",
		"bcryptjs": "^2.4.3",
		"date-fns": "^4.3.0",
		"dotenv": "^16.4.7",
		"drizzle-kit": "^0.30.1",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2"
	}
}